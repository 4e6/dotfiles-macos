# ignore root
/*

# exclude files
!/.gitignore
!/.gitignore.global
!/.gitconfig

!/.aria2/

!/.gnupg/
/.gnupg/*
!/.gnupg/gpg-agent.conf

!/.hammerspoon

!/.vim/
/.vim/plugged/
# vim scratch dirs (see 'Temporary files' in .vimrc) -- generated, never tracked
/.vim/swap/
/.vim/backup/
/.vim/undo/

!/.zshrc

# MCP servers (TrainingPeaks, Open Notebook), submodules; each .venv is ignored by its own .gitignore
!/.local/
/.local/*
!/.local/share/
/.local/share/*
!/.local/share/trainingpeaks-mcp
!/.local/share/open-notebook-mcp

!/Brewfile
!/README.md

# LLM-wiki knowledge bundle + its read-path pointer (see CLAUDE.md)
!/CLAUDE.md
!/.wiki/
